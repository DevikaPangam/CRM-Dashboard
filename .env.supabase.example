# ==============================================================================
# CorpBD CRM — Supabase Cloud Environment Variables
# Copy these values into your .env or .env.local file
# ==============================================================================

# 1. Supabase Project URL (Found under Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Publishable / Anon Public Key (Found under Project Settings -> API -> Project API Keys -> anon public)
# Safe to expose in the browser frontend bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key-here

# 3. Default Organization Configuration for Rajmudra Group
VITE_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
VITE_DEFAULT_ORG_SLUG=rajmudra-group

# ⚠️ SECURITY NOTICE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or SECRET_KEY in frontend (.env / client-side) files!
