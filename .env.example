# =============================================
# CRM Application - Environment Variables
# =============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# Application
PORT=3000
ENVIRONMENT=development

# Security
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
SESSION_TIMEOUT=3600

# Database (SQLite for dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:./db/crm.db
# DATABASE_URL=postgresql://user:password@host:5432/crm_db

# Admin Setup (used only during initial seed)
ADMIN_DEFAULT_PASSWORD=Admin@2026

# Security Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=30
MIN_PASSWORD_LENGTH=8
